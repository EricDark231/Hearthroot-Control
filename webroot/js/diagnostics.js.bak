// Hearthroot Control
// Diagnostics v0.4.0-alpha
// Read-only system inspection

const HearthrootDiagnostics = {
  async execute(command) {
    if (!window.ksu || typeof window.ksu.exec !== "function") {
      throw new Error("BakaSU WebUI API is unavailable");
    }

    const result = await window.ksu.exec(command);

    if (result.errno !== 0) {
      throw new Error(result.stderr || "Command failed");
    }

    return result.stdout.trim();
  },

  async getKernelInfo() {
    return {
      release: await this.execute("uname -r"),
      version: await this.execute("uname -v"),
      device: await this.execute("getprop ro.product.device"),
      android: await this.execute(
        "getprop ro.build.version.release"
      )
    };
  },

  async getCpuPolicies() {
    const command = `
      for policy in /sys/devices/system/cpu/cpufreq/policy*; do
        [ -d "$policy" ] || continue

        echo "POLICY=$(basename "$policy")"

        for file in \
          scaling_governor \
          scaling_available_governors \
          related_cpus \
          scaling_min_freq \
          scaling_max_freq; do

          if [ -r "$policy/$file" ]; then
            echo "$file=$(cat "$policy/$file")"
          fi
        done

        echo "---"
      done
    `;

    return this.execute(command);
  },

  async getIoSchedulers() {
    const command = `
      for device in /sys/block/*; do
        [ -r "$device/queue/scheduler" ] || continue

        echo "DEVICE=$(basename "$device")"
        echo "SCHEDULER=$(cat "$device/queue/scheduler")"
        echo "---"
      done
    `;

    return this.execute(command);
  },

  async collect() {
    return {
      kernel: await this.getKernelInfo(),
      cpu: await this.getCpuPolicies(),
      io: await this.getIoSchedulers()
    };
  }
};

window.HearthrootDiagnostics = HearthrootDiagnostics;
