"use strict";document.querySelectorAll(".choice").forEach(button=>{button.addEventListener("click",()=>{document.querySelectorAll(".choice").forEach(item=>{const selected=item===button;item.classList.toggle("selected",selected);item.setAttribute("aria-pressed",String(selected));});document.getElementById("preview-status").textContent=`${button.dataset.profile} selected for preview. No changes applied.`;});});