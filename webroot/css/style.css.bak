:root {
  color-scheme: dark;
  --cream: #f1e9d8;
  --muted: #c6d5c8;
  --emerald: #75b998;
  --sage: #a6c5a8;
  --gold: #ddc99d;
  --line: rgba(176, 218, 184, .28);
  --glass: rgba(13, 49, 39, .54);
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  background: #102d28;
}

body {
  margin: 0;
  min-height: 100vh;
  color: var(--cream);
  font-family: Georgia, "Times New Roman", serif;
}

.scene {
  position: fixed;
  inset: 0;
  z-index: -3;
  background:
    url('../assets/moonlit-cottage.webp')
    center center / cover no-repeat;
}

.shade {
  position: fixed;
  inset: 0;
  z-index: -2;
  background: linear-gradient(
    180deg,
    rgba(5, 28, 24, .68) 0%,
    rgba(7, 35, 29, .12) 27%,
    rgba(7, 35, 29, .08) 49%,
    rgba(5, 28, 24, .64) 100%
  );
}

.shell {
  width: min(100%, 520px);
  margin: auto;
  padding:
    calc(env(safe-area-inset-top) + 28px)
    17px
    calc(env(safe-area-inset-bottom) + 24px);
}

.mast {
  text-align: left;
  text-shadow: 0 3px 18px rgba(0, 0, 0, .65);
}

.kicker,
.topline,
small,
footer small {
  font-family: system-ui, sans-serif;
  letter-spacing: .16em;
  font-size: 10px;
}

.kicker {
  color: var(--sage);
}

.topline {
  margin-top: 18px;
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--gold);
  letter-spacing: .12em;
}

.ornament {
  color: var(--emerald);
  font-size: 16px;
}

h1 {
  margin: 19px 0 13px;
  font-size: clamp(46px, 11vw, 67px);
  font-weight: 400;
  line-height: .91;
  letter-spacing: -.055em;
}

h1 em {
  color: #c0e4c9;
  font-weight: 400;
}

.tagline {
  margin: 0;
  color: #e1e9da;
  font-size: 16px;
  font-style: italic;
}

.breathing-space {
  height: clamp(205px, 31vh, 340px);
}

/* Emerald glass */

.glass {
  position: relative;
  overflow: hidden;
  isolation: isolate;

  border: 1px solid var(--line);
  border-radius: 22px;

  background: linear-gradient(
    145deg,
    rgba(23, 77, 58, .64),
    rgba(9, 36, 31, .48)
  );

  -webkit-backdrop-filter: blur(14px) saturate(1.12);
  backdrop-filter: blur(14px) saturate(1.12);

  box-shadow:
    0 10px 30px rgba(0, 18, 13, .22),
    inset 0 1px rgba(220, 255, 224, .11);
}

/* Subtle botanical corners */

.glass::before,
.glass::after {
  content: "❧";
  position: absolute;
  z-index: -1;
  color: rgba(163, 216, 166, .24);
  font-size: 48px;
  line-height: 1;
  pointer-events: none;
}

.glass::before {
  top: -12px;
  right: 6px;
  transform: rotate(-32deg);
}

.glass::after {
  bottom: -17px;
  left: 5px;
  transform: rotate(148deg);
}

/* Device status */

.status {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
  padding: 18px 19px;
}

.status > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.status-side {
  border-left: 1px solid var(--line);
  padding-left: 16px;
}

.status small,
.section-heading small {
  color: var(--sage);
}

.status strong {
  font-family: system-ui, sans-serif;
  font-size: 13px;
  font-weight: 600;
}

.status span {
  color: var(--muted);
  font: 11px system-ui, sans-serif;
}

/* Profiles */

.profiles {
  margin-top: 14px;
  padding: 20px 16px 16px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-heading h2 {
  margin: 5px 0 17px;
  font-size: 29px;
  font-weight: 400;
}

.tiny-ornament {
  color: var(--sage);
  font-size: 27px;
}

.choices {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 9px;
}

.choice {
  min-width: 0;
  min-height: 138px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;

  padding: 13px 5px;

  border: 1px solid rgba(172, 220, 185, .20);
  border-radius: 15px;

  background: rgba(5, 37, 28, .34);
  color: var(--cream);

  font: inherit;
  cursor: pointer;

  transition:
    background .25s ease,
    border-color .25s ease,
    box-shadow .25s ease,
    transform .2s ease;
}

.choice:active {
  transform: scale(.97);
}

.choice:focus-visible {
  outline: 2px solid var(--sage);
  outline-offset: 3px;
}

.choice.selected {
  border-color: rgba(164, 235, 185, .76);

  background: linear-gradient(
    160deg,
    rgba(32, 116, 81, .63),
    rgba(13, 63, 45, .53)
  );

  box-shadow:
    inset 0 0 20px rgba(116, 209, 147, .13),
    0 0 16px rgba(88, 180, 120, .13);
}

.sigil {
  color: var(--sage);
  font-size: 32px;
  line-height: 1;
}

.choice.selected .sigil {
  color: #d4f1d5;
}

.choice strong {
  font-size: 15px;
  font-weight: 400;
}

.choice > span:last-child {
  color: #d2dfd1;
  font: 10px system-ui, sans-serif;
  text-align: center;
}

.notice {
  margin-top: 16px;
  padding: 12px 4px 0;

  border-top: 1px solid rgba(174, 223, 183, .16);

  color: #d5e5d4;
  font: 11px/1.6 system-ui, sans-serif;
}

/* Footer */

footer {
  display: flex;
  flex-direction: column;
  gap: 12px;

  padding: 26px 0 10px;

  color: var(--sage);
  text-align: center;
  font-style: italic;
}

footer small {
  color: #d0dfcd;
  font-style: normal;
}

@media (max-width: 350px) {
  .shell {
    padding-left: 11px;
    padding-right: 11px;
  }

  .choice strong {
    font-size: 13px;
  }

  .profiles {
    padding: 15px 10px;
  }

  .status {
    padding: 15px 12px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    transition: none !important;
    animation: none !important;
  }
}
