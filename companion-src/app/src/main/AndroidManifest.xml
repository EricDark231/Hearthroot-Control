<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission
        android:name="dev.hearthroot.companion.permission.CONTROL"
        android:protectionLevel="signature" />
    <uses-permission android:name="dev.hearthroot.companion.permission.CONTROL" />
    <queries>
        <package android:name="com.xiaomi.settings" />
    </queries>

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="Hearthroot Companion"
        android:description="@string/module_description"
        android:hasCode="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Hearthroot Companion"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Solo verifica el puente en segundo plano; no cambia el perfil. -->
        <receiver
            android:name=".BootBridgeReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Root-only IPC; Binder.getCallingUid() validates uid=0 for every call. -->
        <provider
            android:name=".RootBridgeProvider"
            android:authorities="dev.hearthroot.companion.rootbridge"
            android:exported="true"
            android:directBootAware="true" />
    </application>
</manifest>
